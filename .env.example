# SyncDub backend configuration (all optional — defaults are portable).
# Copy to .env or export in your shell; backend/config.py reads these.

# ffmpeg binary. Default: "ffmpeg" from PATH.
# Example (Windows conda): SYNCDUB_FFMPEG=D:/Miniconda3/envs/lipdub_env/Library/bin/ffmpeg.exe
#SYNCDUB_FFMPEG=ffmpeg

# Python interpreter of the separate XTTS v2 voice-cloning environment
# (its dependencies conflict with the main env; pinned in requirements-clone.txt,
# invoked via backend/clone_bridge.py).
# Unset => voice cloning unavailable, pipeline uses stock Edge-TTS voices.
# Example (venv):        SYNCDUB_CLONE_PYTHON=/path/to/.venv-clone/bin/python
# Example (Windows conda): SYNCDUB_CLONE_PYTHON=D:/Miniconda3/envs/voiceclone_env/python.exe
#SYNCDUB_CLONE_PYTHON=

# Force voice cloning availability on/off explicitly
# (default: available only if SYNCDUB_CLONE_PYTHON is set).
# Note: availability is not activation — cloning runs only when a job requests
# it AND carries speaker consent (docs/founder-os/05-responsible-synthetic-media.md §5.2).
#SYNCDUB_VOICE_CLONING=false
